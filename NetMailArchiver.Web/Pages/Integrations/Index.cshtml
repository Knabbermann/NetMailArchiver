@page
@model NetMailArchiver.Web.Pages.Integrations.IndexModel
@{
    ViewData["Title"] = "Integrations";
}

<style>
    /* Simple: No animations, no fade effects for this page */
    #auto-categorization .card,
    #auto-categorization .stat-card,
    #auto-categorization * {
        opacity: 1 !important;
        visibility: visible !important;
        display: block !important;
        animation: none !important;
        transition: none !important;
    }

    #auto-categorization .row {
        display: flex !important;
    }
</style>

<!-- Page Header -->
<div class="page-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="display-5 fw-bold mb-2">
                    <i class="fas fa-plug me-3"></i>Integrations
                </h1>
                <p class="lead mb-0 opacity-90">
                    Manage your email accounts and external integrations
                </p>
            </div>
        </div>
    </div>
</div>

<div class="container py-4">
    <!-- Tab Navigation -->
    <ul class="nav nav-tabs mb-4" id="integrationTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="mail-accounts-tab" data-bs-toggle="tab" 
                    data-bs-target="#mail-accounts" type="button" role="tab" 
                    aria-controls="mail-accounts" aria-selected="true">
                <i class="fas fa-server me-2"></i>Mail Accounts
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="n8n-webhook-tab" data-bs-toggle="tab" 
                    data-bs-target="#n8n-webhook" type="button" role="tab" 
                    aria-controls="n8n-webhook" aria-selected="false">
                <i class="fas fa-robot me-2"></i>n8n AI Agent
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="auto-categorization-tab" data-bs-toggle="tab" 
                    data-bs-target="#auto-categorization" type="button" role="tab" 
                    aria-controls="auto-categorization" aria-selected="false">
                <i class="fas fa-tags me-2"></i>Auto-Categorization
            </button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content" id="integrationTabsContent">

        <!-- Mail Accounts Tab -->
        <div class="tab-pane fade show active" id="mail-accounts" role="tabpanel" aria-labelledby="mail-accounts-tab">
            @if (Model.ImapInformations.Any())
            {
                <!-- Action Buttons -->
                <div class="d-flex justify-content-end gap-2 mb-4">
                    <a class="btn btn-primary" asp-page="/Integrations/MailAccounts/Add">
                        <i class="fas fa-plus me-2"></i>Add Account
                    </a>
                    <button class="btn btn-outline-primary" onclick="testAllConnections()" id="testAllBtn">
                        <i class="fas fa-network-wired me-2"></i>Test All
                    </button>
                </div>

                <!-- Statistics Overview -->
                <div class="row g-4 mb-5">
                    <div class="col-lg-3 col-md-6">
                        <div class="stat-card fade-in-up">
                            <div class="stat-icon mb-3">
                                <i class="fas fa-server"></i>
                            </div>
                            <div class="stat-number">@Model.ImapInformations.Count()</div>
                            <div class="stat-label">Total Accounts</div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="stat-card fade-in-up" style="animation-delay: 0.1s;">
                            <div class="stat-icon mb-3">
                                <i class="fas fa-shield-alt"></i>
                            </div>
                            <div class="stat-number">@Model.ImapInformations.Count(x => x.UseSsl)</div>
                            <div class="stat-label">SSL Enabled</div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="stat-card fade-in-up" style="animation-delay: 0.2s;">
                            <div class="stat-icon mb-3">
                                <i class="fas fa-check-circle"></i>
                            </div>
                            <div class="stat-number" id="activeConnections">-</div>
                            <div class="stat-label">Active Connections</div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="stat-card fade-in-up" style="animation-delay: 0.3s;">
                            <div class="stat-icon mb-3">
                                <i class="fas fa-envelope"></i>
                            </div>
                            <div class="stat-number">@Model.ImapInformations.Sum(x => x.EmailCount).ToString("N0")</div>
                            <div class="stat-label">Total Emails</div>
                        </div>
                    </div>
                </div>

                <!-- Accounts Grid -->
                <div class="row g-4">
                    @foreach (var (obj, index) in Model.ImapInformations.Select((obj, index) => (obj, index)))
                    {
                        <div class="col-lg-6 col-xl-4 fade-in-up" style="animation-delay: @((index * 0.1 + 0.4))s;">
                            <div class="card h-100 account-card" data-account-id="@obj.Id">
                                <div class="card-header d-flex justify-content-between align-items-center py-3">
                                    <div class="d-flex align-items-center">
                                        <div class="status-indicator me-3" id="status-@obj.Id"></div>
                                        <div>
                                            <h6 class="mb-0 fw-bold">@obj.Host</h6>
                                            <small class="text-white-50">Port: @obj.Port</small>
                                        </div>
                                    </div>
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-light dropdown-toggle" type="button" 
                                                data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="fas fa-ellipsis-v"></i>
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li>
                                                <a class="dropdown-item" asp-page="/Integrations/MailAccounts/Edit" asp-route-id="@obj.Id">
                                                    <i class="fas fa-edit me-2 text-primary"></i>Edit Account
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" href="/Archive/Index">
                                                    <i class="fas fa-archive me-2 text-info"></i>View Archive
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <a class="dropdown-item text-danger" asp-page="/Integrations/MailAccounts/Delete" asp-route-id="@obj.Id">
                                                    <i class="fas fa-trash me-2"></i>Delete Account
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </div>

                                <div class="card-body">
                                    <!-- Account Info -->
                                    <div class="account-info mb-4">
                                        <div class="d-flex align-items-center mb-3">
                                            <i class="fas fa-user text-primary me-3"></i>
                                            <div>
                                                <div class="fw-semibold">@obj.Username</div>
                                                <small class="text-muted">Email Account</small>
                                            </div>
                                        </div>

                                        <div class="d-flex align-items-center mb-3">
                                            <i class="fas fa-shield-alt @(obj.UseSsl ? "text-success" : "text-warning") me-3"></i>
                                            <div>
                                                <div class="fw-semibold">@(obj.UseSsl ? "SSL Enabled" : "SSL Disabled")</div>
                                                <small class="text-muted">Security Protocol</small>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Statistics -->
                                    <div class="row g-3 mb-4">
                                        <div class="col-6">
                                            <div class="text-center p-3 bg-light rounded">
                                                <div class="h5 text-primary mb-1">@obj.EmailCount.ToString("N0")</div>
                                                <small class="text-muted fw-medium">Emails</small>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="text-center p-3 bg-light rounded">
                                                <div class="h5 text-secondary mb-1">@obj.AttachmentCount.ToString("N0")</div>
                                                <small class="text-muted fw-medium">Attachments</small>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Connection Status -->
                                    <div class="connection-status mb-4" id="connection-@obj.Id">
                                        <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded">
                                            <div class="d-flex align-items-center">
                                                <div class="spinner-border-custom me-3 d-none" id="spinner-@obj.Id"></div>
                                                <i class="fas fa-question-circle text-muted me-3" id="icon-@obj.Id"></i>
                                                <div>
                                                    <div class="fw-medium" id="status-text-@obj.Id">Unknown</div>
                                                    <small class="text-muted">Connection Status</small>
                                                </div>
                                            </div>
                                            <div class="connection-actions">
                                                <button class="btn btn-sm btn-outline-primary test-connection-btn" 
                                                        data-id="@obj.Id" data-bs-toggle="tooltip" title="Test Connection">
                                                    <i class="fas fa-plug"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Action Buttons -->
                                    <div class="d-grid gap-2">
                                        <form asp-page-handler="TestConnection" asp-route-id="@obj.Id" method="post" class="w-100">
                                            <button type="submit" class="btn btn-primary w-100 check-connection-btn" data-id="@obj.Id">
                                                <i class="fas fa-network-wired me-2"></i>
                                                <span>Check Connection</span>
                                            </button>
                                        </form>

                                        <div class="btn-group w-100" role="group">
                                            <a class="btn btn-outline-secondary" asp-page="/Integrations/MailAccounts/Edit" asp-route-id="@obj.Id">
                                                <i class="fas fa-edit me-2"></i>Edit
                                            </a>
                                            <a class="btn btn-outline-danger" asp-page="/Integrations/MailAccounts/Delete" asp-route-id="@obj.Id">
                                                <i class="fas fa-trash me-2"></i>Remove
                                            </a>
                                        </div>
                                    </div>
                                </div>

                                <!-- Last Updated Footer -->
                                <div class="card-footer bg-transparent border-0 pt-0">
                                    <small class="text-muted d-flex align-items-center">
                                        <i class="fas fa-clock me-2"></i>
                                        Last checked: <span class="ms-1" id="last-checked-@obj.Id">Never</span>
                                    </small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Empty State -->
                <div class="text-center py-5 fade-in-up">
                    <div class="empty-state">
                        <i class="fas fa-server fa-4x text-muted mb-4"></i>
                        <h3 class="text-muted mb-3">No Mail Accounts Configured</h3>
                        <p class="text-muted mb-4 lead">
                            Set up your first email account to start archiving your emails.
                        </p>
                        <a class="btn btn-primary btn-lg" asp-page="/Integrations/MailAccounts/Add">
                            <i class="fas fa-plus me-2"></i>Add Your First Account
                        </a>
                    </div>
                </div>
            }
        </div>

        <!-- n8n Webhook Tab -->
        <div class="tab-pane fade" id="n8n-webhook" role="tabpanel" aria-labelledby="n8n-webhook-tab">
            <div class="row">
                <div class="col-lg-8 mx-auto">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">
                                <i class="fas fa-robot me-2"></i>n8n AI Agent Configuration
                            </h5>
                        </div>
                        <div class="card-body">
                            <!-- Info Alert -->
                            <div class="alert alert-info mb-4 alert-permanent">
                                <i class="fas fa-info-circle me-2"></i>
                                <strong>What is this?</strong> Configure your n8n webhook to enable AI-powered email processing, 
                                including automatic categorization, sentiment analysis, and smart tagging.
                            </div>

                            <form method="post" asp-page-handler="SaveWebhook">
                                <div class="mb-4">
                                    <label asp-for="IntegrationSettings.N8nWebhookUrl" class="form-label">
                                        <i class="fas fa-link me-2"></i>Webhook URL
                                    </label>
                                    <input asp-for="IntegrationSettings.N8nWebhookUrl" 
                                           class="form-control" 
                                           placeholder="https://your-n8n-instance.com/webhook/your-webhook-id" />
                                    <span asp-validation-for="IntegrationSettings.N8nWebhookUrl" class="text-danger"></span>
                                    <small class="form-text text-muted">
                                        Enter the complete webhook URL from your n8n workflow
                                    </small>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="IntegrationSettings.Description" class="form-label">
                                        <i class="fas fa-comment me-2"></i>Description
                                    </label>
                                    <textarea asp-for="IntegrationSettings.Description" 
                                              class="form-control" 
                                              rows="3" 
                                              placeholder="Describe what your AI agent does..."></textarea>
                                    <span asp-validation-for="IntegrationSettings.Description" class="text-danger"></span>
                                </div>

                                <div class="mb-4">
                                    <div class="form-check form-switch">
                                        <input asp-for="IntegrationSettings.IsWebhookEnabled" 
                                               class="form-check-input" 
                                               type="checkbox" 
                                               role="switch" />
                                        <label asp-for="IntegrationSettings.IsWebhookEnabled" class="form-check-label">
                                            Enable Webhook
                                        </label>
                                    </div>
                                    <small class="form-text text-muted">
                                        When enabled, archived emails will be sent to your n8n workflow
                                    </small>
                                </div>

                                @if (Model.IntegrationSettings.UpdatedAt.HasValue)
                                {
                                    <div class="alert alert-secondary mb-4 alert-permanent">
                                        <i class="fas fa-clock me-2"></i>
                                        Last updated: @Model.IntegrationSettings.UpdatedAt.Value.ToLocalTime().ToString("g")
                                    </div>
                                }

                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-save me-2"></i>Save Configuration
                                    </button>
                                </div>
                            </form>

                            <!-- Test Webhook Section -->
                            @if (!string.IsNullOrWhiteSpace(Model.IntegrationSettings.N8nWebhookUrl))
                            {
                                <hr class="my-4" />
                                <h6 class="mb-3">
                                    <i class="fas fa-flask me-2"></i>Test Webhook
                                </h6>
                                <form method="post" asp-page-handler="TestWebhook">
                                    <button type="submit" class="btn btn-outline-primary">
                                        <i class="fas fa-paper-plane me-2"></i>Send Test Request
                                    </button>
                                </form>
                            }

                            <!-- Usage Examples -->
                            <hr class="my-4" />
                            <h6 class="mb-3">
                                <i class="fas fa-lightbulb me-2"></i>AI Agent Use Cases
                            </h6>
                            <ul class="list-unstyled">
                                <li class="mb-2">
                                    <i class="fas fa-check text-success me-2"></i>
                                    <strong>Email Categorization:</strong> Automatically classify emails (Invoice, Support, Newsletter, etc.)
                                </li>
                                <li class="mb-2">
                                    <i class="fas fa-check text-success me-2"></i>
                                    <strong>Sentiment Analysis:</strong> Detect urgency and tone of incoming emails
                                </li>
                                <li class="mb-2">
                                    <i class="fas fa-check text-success me-2"></i>
                                    <strong>Smart Tagging:</strong> Generate relevant tags based on email content
                                </li>
                                <li class="mb-2">
                                    <i class="fas fa-check text-success me-2"></i>
                                    <strong>Information Extraction:</strong> Extract dates, amounts, and contacts
                                </li>
                                <li class="mb-2">
                                    <i class="fas fa-check text-success me-2"></i>
                                    <strong>Email Summarization:</strong> Create summaries for long email threads
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Auto-Categorization Tab -->
        <div class="tab-pane fade" id="auto-categorization" role="tabpanel" aria-labelledby="auto-categorization-tab" tabindex="0">
            <div class="row">
                <div class="col-lg-12">
                    <!-- Statistics -->
                    <div class="row g-3 mb-4" id="categorization-stats">
                        <div class="col-md-3">
                            <div class="card">
                                <div class="card-body text-center">
                                    <i class="fas fa-tags fa-2x text-primary mb-2"></i>
                                    <h4 class="mb-0">@(Model.TotalCategories)</h4>
                                    <small class="text-muted">Total Categories</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card">
                                <div class="card-body text-center">
                                    <i class="fas fa-check-circle fa-2x text-success mb-2"></i>
                                    <h4 class="mb-0">@(Model.CategorizedEmailsCount)</h4>
                                    <small class="text-muted">Categorized Emails</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card">
                                <div class="card-body text-center">
                                    <i class="fas fa-question-circle fa-2x text-warning mb-2"></i>
                                    <h4 class="mb-0">@(Model.UncategorizedEmailsCount)</h4>
                                    <small class="text-muted">Uncategorized Emails</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card">
                                <div class="card-body text-center">
                                    <i class="fas fa-percentage fa-2x text-info mb-2"></i>
                                    <h4 class="mb-0">
                                        @{
                                            var totalEmails = Model.CategorizedEmailsCount + Model.UncategorizedEmailsCount;
                                            var percentage = totalEmails > 0 ? ((double)Model.CategorizedEmailsCount * 100.0 / (double)totalEmails) : 0;
                                        }
                                        @percentage.ToString("F1")%
                                    </h4>
                                    <small class="text-muted">Coverage</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">
                                <i class="fas fa-robot me-2"></i>Automatic Categorization
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="alert alert-info alert-permanent">
                                <i class="fas fa-info-circle me-2"></i>
                                <strong>How it works:</strong> The AI agent analyzes email content (subject, sender, body) 
                                and automatically assigns the most appropriate category. Make sure the n8n webhook is configured first.
                            </div>

                            @if (!Model.IntegrationSettings.IsWebhookEnabled || string.IsNullOrWhiteSpace(Model.IntegrationSettings.N8nWebhookUrl))
                            {
                                <div class="alert alert-warning mb-4 alert-permanent">
                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                    <strong>Configuration Required:</strong> 
                                    Please configure and enable the n8n webhook in the "n8n AI Agent" tab first.
                                </div>
                            }

                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <h6>
                                        <i class="fas fa-magic me-2 text-primary"></i>Categorize All Emails
                                    </h6>
                                    <p class="text-muted mb-3">
                                        Process all uncategorized emails in your archive using AI. This may take several minutes depending on the number of emails.
                                    </p>
                                    <form method="post" asp-page-handler="StartCategorization">
                                        <button type="submit" class="btn btn-primary" 
                                                @(!Model.IntegrationSettings.IsWebhookEnabled || string.IsNullOrWhiteSpace(Model.IntegrationSettings.N8nWebhookUrl) ? "disabled" : "")>
                                            <i class="fas fa-play me-2"></i>Start Bulk Categorization
                                        </button>
                                    </form>
                                </div>

                                <div class="col-md-6">
                                    <h6>
                                        <i class="fas fa-bolt me-2 text-warning"></i>Automatic for New Emails
                                    </h6>
                                    <p class="text-muted mb-3">
                                        New emails are automatically categorized when archived. No action needed - it happens in the background!
                                    </p>
                                    @if (Model.IntegrationSettings.IsWebhookEnabled && !string.IsNullOrWhiteSpace(Model.IntegrationSettings.N8nWebhookUrl))
                                    {
                                        <div class="alert alert-success mb-0 alert-permanent">
                                            <i class="fas fa-check-circle me-2"></i>
                                            Auto-categorization is <strong>active</strong>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-secondary mb-0 alert-permanent">
                                            <i class="fas fa-info-circle me-2"></i>
                                            Auto-categorization is <strong>inactive</strong>
                                        </div>
                                    }
                                </div>
                            </div>

                            <hr />

                            <h6 class="mb-3">
                                <i class="fas fa-cog me-2"></i>AI Response Format
                            </h6>
                            <p class="text-muted">
                                Your n8n workflow should return a JSON response with the following structure:
                            </p>
                            <pre class="bg-light p-3 rounded"><code>{
  "categoryName": "Invoice",
  "confidence": 0.95,
  "reasoning": "Email contains invoice number and billing information"
}</code></pre>
                            <small class="text-muted">
                                The <code>categoryName</code> must match an existing category (case-insensitive).
                            </small>
                        </div>
                    </div>

                    <!-- Manage Categories Card -->
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">
                                <i class="fas fa-tags me-2"></i>Manage Categories
                            </h5>
                        </div>
                        <div class="card-body">
                            <p class="text-muted mb-3">
                                Categories are used to organize your emails. You can create custom categories or use the pre-defined system categories.
                            </p>
                            <a class="btn btn-outline-primary" asp-page="/Integrations/Categories/Index">
                                <i class="fas fa-cog me-2"></i>View All Categories
                            </a>
                            <a class="btn btn-outline-success" asp-page="/Integrations/Categories/Add">
                                <i class="fas fa-plus me-2"></i>Add New Category
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            // Simple: Just initialize tooltips
            $('[data-bs-toggle="tooltip"]').tooltip();

            // Auto-test connections on page load
            if ($('#mail-accounts').hasClass('active')) {
                setTimeout(autoTestConnections, 1000);
            }

            $('.test-connection-btn').on('click', function() {
                const accountId = $(this).data('id');
                testSingleConnection(accountId);
            });

            $('.check-connection-btn').on('click', function(e) {
                const $btn = $(this);
                $btn.prop('disabled', true)
                    .html('<i class="fas fa-spinner fa-spin me-2"></i>Checking...');
            });
        });

        function autoTestConnections() {
            $('.test-connection-btn').each(function() {
                const accountId = $(this).data('id');
                testSingleConnection(accountId, true);
            });
        }

        function testSingleConnection(accountId, isAuto = false) {
            const $spinner = $(`#spinner-${accountId}`);
            const $icon = $(`#icon-${accountId}`);
            const $statusText = $(`#status-text-${accountId}`);
            const $lastChecked = $(`#last-checked-${accountId}`);
            const $statusIndicator = $(`#status-${accountId}`);

            if (!isAuto) {
                $spinner.removeClass('d-none');
                $icon.addClass('d-none');
            }

            $statusText.text('Testing...');

            // Simulate connection test (replace with actual API call)
            setTimeout(() => {
                const isSuccess = Math.random() > 0.3; // 70% success rate for demo

                $spinner.addClass('d-none');
                $icon.removeClass('d-none');

                if (isSuccess) {
                    $icon.removeClass('fa-question-circle fa-times-circle text-muted text-danger')
                         .addClass('fa-check-circle text-success');
                    $statusText.text('Connected');
                    $statusIndicator.removeClass('offline').addClass('online');

                    if (!isAuto) {
                        toastr.success(`Connection successful`);
                    }
                } else {
                    $icon.removeClass('fa-question-circle fa-check-circle text-muted text-success')
                         .addClass('fa-times-circle text-danger');
                    $statusText.text('Failed');
                    $statusIndicator.removeClass('online').addClass('offline');

                    if (!isAuto) {
                        toastr.error(`Connection failed`);
                    }
                }

                $lastChecked.text(new Date().toLocaleTimeString());
                updateActiveConnections();
            }, isAuto ? Math.random() * 2000 + 500 : 1500);
        }

        function testAllConnections() {
            const $btn = $('#testAllBtn');
            $btn.prop('disabled', true)
                .html('<i class="fas fa-spinner fa-spin me-2"></i>Testing...');

            $('.test-connection-btn').each(function() {
                const accountId = $(this).data('id');
                testSingleConnection(accountId);
            });

            setTimeout(() => {
                $btn.prop('disabled', false)
                    .html('<i class="fas fa-network-wired me-2"></i>Test All');
                toastr.success('All connection tests completed');
            }, 3000);
        }

        function updateActiveConnections() {
            const activeCount = $('.fa-check-circle.text-success').length;
            $('#activeConnections').text(activeCount);
        }
    </script>
}
