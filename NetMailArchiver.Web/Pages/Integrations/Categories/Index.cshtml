@page
@model NetMailArchiver.Web.Pages.Integrations.Categories.IndexModel
@{
    ViewData["Title"] = "Manage Categories";
}

<div class="container py-4">
    <div class="row align-items-center mb-4">
        <div class="col-lg-8">
            <h2 class="mb-2">
                <i class="fas fa-tags me-2"></i>Email Categories
            </h2>
            <p class="text-muted mb-0">Manage categories for automatic email classification</p>
        </div>
        <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
            <a class="btn btn-primary" asp-page="/Integrations/Categories/Add">
                <i class="fas fa-plus me-2"></i>Add Category
            </a>
        </div>
    </div>

    @if (Model.Categories.Any())
    {
        <!-- Statistics -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body text-center">
                        <i class="fas fa-tags fa-2x text-primary mb-2"></i>
                        <h4 class="mb-0">@Model.Categories.Count</h4>
                        <small class="text-muted">Total Categories</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body text-center">
                        <i class="fas fa-shield-alt fa-2x text-info mb-2"></i>
                        <h4 class="mb-0">@Model.Categories.Count(c => c.IsSystem)</h4>
                        <small class="text-muted">System Categories</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body text-center">
                        <i class="fas fa-user-tag fa-2x text-success mb-2"></i>
                        <h4 class="mb-0">@Model.Categories.Count(c => !c.IsSystem)</h4>
                        <small class="text-muted">Custom Categories</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body text-center">
                        <i class="fas fa-envelope fa-2x text-warning mb-2"></i>
                        <h4 class="mb-0">@Model.Categories.Sum(c => c.EmailCount)</h4>
                        <small class="text-muted">Categorized Emails</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Categories Table -->
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-list me-2"></i>All Categories
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 50px;"></th>
                                <th>Name</th>
                                <th>Description</th>
                                <th style="width: 100px;">Type</th>
                                <th style="width: 100px;">Emails</th>
                                <th style="width: 120px;">Created</th>
                                <th style="width: 150px;" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var category in Model.Categories)
                            {
                                <tr>
                                    <td class="text-center">
                                        <div style="width: 30px; height: 30px; background-color: @category.Color; border-radius: 6px; display: inline-flex; align-items: center; justify-content: center;">
                                            <i class="fas @category.Icon text-white"></i>
                                        </div>
                                    </td>
                                    <td>
                                        <strong>@category.Name</strong>
                                        @if (category.IsDefault)
                                        {
                                            <span class="badge bg-info ms-2">Default</span>
                                        }
                                    </td>
                                    <td>
                                        <small class="text-muted">@(category.Description ?? "-")</small>
                                    </td>
                                    <td>
                                        @if (category.IsSystem)
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="fas fa-shield-alt me-1"></i>System
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary">
                                                <i class="fas fa-user me-1"></i>Custom
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark">@category.EmailCount</span>
                                    </td>
                                    <td>
                                        <small class="text-muted">@category.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</small>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a class="btn btn-outline-primary" asp-page="/Integrations/Categories/Edit" asp-route-id="@category.Id">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            @if (!category.IsSystem)
                                            {
                                                <a class="btn btn-outline-danger" asp-page="/Integrations/Categories/Delete" asp-route-id="@category.Id">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <button class="btn btn-outline-secondary" disabled title="System categories cannot be deleted">
                                                    <i class="fas fa-lock"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Info Box -->
        <div class="alert alert-info mt-4">
            <i class="fas fa-info-circle me-2"></i>
            <strong>About Categories:</strong>
            System categories are predefined and cannot be deleted. You can create custom categories for your specific needs.
            The default category is used for emails that couldn't be categorized automatically.
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="text-center py-5">
            <i class="fas fa-tags fa-4x text-muted mb-4"></i>
            <h3 class="text-muted mb-3">No Categories Found</h3>
            <p class="text-muted mb-4">
                Get started by creating your first email category.
            </p>
            <a class="btn btn-primary btn-lg" asp-page="/Integrations/Categories/Add">
                <i class="fas fa-plus me-2"></i>Create First Category
            </a>
        </div>
    }
</div>

<a class="btn btn-outline-secondary mb-3" asp-page="/Integrations/Index">
    <i class="fas fa-arrow-left me-2"></i>Back to Integrations
</a>
