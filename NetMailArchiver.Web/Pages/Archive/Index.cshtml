@page
@model NetMailArchiver.Web.Pages.Archive.IndexModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var token = Antiforgery.GetAndStoreTokens(HttpContext).RequestToken;
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<div style="padding-top: 50px"></div>
<div class="accordion" id="imapAccordion">
    @foreach (var imapInformation in Model.ImapInformations)
    {
        <div class="accordion-item">
            <h2 class="accordion-header" id="heading_@imapInformation.Id">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_@imapInformation.Id" aria-expanded="false" aria-controls="collapse_@imapInformation.Id">
                    <h2 class="text-info mb-0">@imapInformation.Username</h2>
                </button>
            </h2>
            <div id="collapse_@imapInformation.Id" class="accordion-collapse collapse" aria-labelledby="heading_@imapInformation.Id" data-bs-parent="#imapAccordion">
                <div class="accordion-body">

                    <div class="card border-0 bg-light mb-3">
                        <div class="card-body py-3">
                            <div class="row g-3 align-items-start">
                                <div class="col-12 col-md-5">
                                    <label class="form-label fw-semibold text-muted small mb-1">
                                        <i class="bi bi-search me-1"></i>Search text
                                    </label>
                                    <input type="text" class="form-control search-input" id="searchInput_@imapInformation.Id" placeholder="Subject, sender..." />
                                    <div class="form-check mt-2">
                                        <input class="form-check-input search-body-checkbox" type="checkbox" id="searchBody_@imapInformation.Id">
                                        <label class="form-check-label small text-muted" for="searchBody_@imapInformation.Id">
                                            Include email body
                                        </label>
                                    </div>
                                </div>

                                <div class="col-12 col-md-5">
                                    <label class="form-label fw-semibold text-muted small mb-1">
                                        <i class="bi bi-calendar-range me-1"></i>Date range
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white"><i class="bi bi-calendar3"></i></span>
                                        <input type="text" class="form-control date-range-picker" id="dateRange_@imapInformation.Id"
                                               placeholder="Select date range..." readonly />
                                        <button class="btn btn-outline-secondary clearDates" type="button" data-imap-id="@imapInformation.Id" title="Clear date filter">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                    <input type="hidden" class="date-from" id="dateFrom_@imapInformation.Id" />
                                    <input type="hidden" class="date-to" id="dateTo_@imapInformation.Id" />
                                </div>

                                <div class="col-12 col-md-2 d-flex flex-column gap-2">
                                    <button class="btn btn-info searchEmail w-100" data-imap-id="@imapInformation.Id">
                                        <i class="bi bi-search me-1"></i>Search
                                    </button>
                                    <button class="btn btn-outline-secondary resetSearch w-100" data-imap-id="@imapInformation.Id">
                                        <i class="bi bi-arrow-counterclockwise me-1"></i>Reset
                                    </button>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-outline-warning flex-fill toggleFilterFavorite" data-imap-id="@imapInformation.Id" title="Show only favorites">
                                            <i class="far fa-star me-1"></i>Favorites
                                        </button>
                                        <button class="btn btn-outline-danger flex-fill toggleFilterFollowUp" data-imap-id="@imapInformation.Id" title="Show only follow-ups">
                                            <i class="far fa-flag me-1"></i>Follow-Up
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-2 email-spinner align-items-center gap-2 text-muted" id="loadingSpinner_@imapInformation.Id">
                                <div class="spinner-border spinner-border-sm text-info" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <small>Searching emails...</small>
                            </div>
                        </div>
                    </div>
                    <div id="emailTable_@imapInformation.Id">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>From</th>
                                    <th>Subject</th>
                                    <th width="120px" class="text-center">Markers</th>
                                    <th class="fst-italic">Action</th>
                                </tr>
                            </thead>
                            <tbody id="emailTableBody_@imapInformation.Id">
                            </tbody>
                        </table>
                        <div class="pagination">
                            <div class="d-flex justify-content-between mt-3">
                                <button class="btn btn-info prevPage" data-imap-id="@imapInformation.Id" disabled>
                                    <i class="bi bi-arrow-left"></i> Previous
                                </button>
                                <span style="padding: 10px">Page: <span id="currentPage_@imapInformation.Id">1</span></span>
                                <button class="btn btn-info nextPage" data-imap-id="@imapInformation.Id">
                                    <i class="bi bi-arrow-right"></i> Next
                                </button>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<script>
    $(document).ready(function () {

        // Initialize Flatpickr date range pickers for each accordion
        document.querySelectorAll('.date-range-picker').forEach(function (el) {
            const imapId = el.id.replace('dateRange_', '');
            flatpickr(el, {
                mode: 'range',
                dateFormat: 'd.m.Y',
                locale: {
                    rangeSeparator: ' – '
                },
                allowInput: false,
                onChange: function (selectedDates) {
                    if (selectedDates.length === 2) {
                        const pad = n => String(n).padStart(2, '0');
                        const fmt = d => d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
                        $('#dateFrom_' + imapId).val(fmt(selectedDates[0]));
                        $('#dateTo_' + imapId).val(fmt(selectedDates[1]));
                    } else {
                        $('#dateFrom_' + imapId).val('');
                        $('#dateTo_' + imapId).val('');
                    }
                },
                onReady: function (selectedDates, dateStr, instance) {
                    instance.calendarContainer.style.zIndex = 9999;
                }
            });
        });

        function loadEmails(imapId, page, pageSize, searchQuery, searchBody, dateFrom, dateTo, filterFavorite, filterFollowUp) {

            const $tableBody = $('#emailTableBody_' + imapId);
            const $currentPage = $('#currentPage_' + imapId);
            const $prevPage = $('[data-imap-id="' + imapId + '"].prevPage');
            const $nextPage = $('[data-imap-id="' + imapId + '"].nextPage');
            const $spinner = $('#loadingSpinner_' + imapId);
            const $table = $('#emailTable_' + imapId);

            $spinner.addClass('visible');
            $table.hide();

            $.ajax({
                url: '/Archive/Index?handler=Mails',
                type: 'GET',
                data: { ImapId: imapId, page: page, pageSize: pageSize, searchQuery: searchQuery, searchBody: searchBody, dateFrom: dateFrom || '', dateTo: dateTo || '', filterFavorite: filterFavorite || false, filterFollowUp: filterFollowUp || false },
                success: function (data) {
                    $tableBody.empty();

                    $.each(data.emails, function (index, email) {
                        const hasAttachments = email.attachments && email.attachments.count > 0;
                        const attachmentButton = hasAttachments
                            ? '<button class="btn btn-link downloadAttachment" data-email-id="' + email.id + '">Download Attachments</button>'
                            : '';

                        const favoriteIcon = email.isFavorite 
                            ? '<i class="fas fa-star text-warning"></i>' 
                            : '<i class="far fa-star text-muted"></i>';
                        const followUpIcon = email.isFollowUp 
                            ? '<i class="fas fa-flag text-danger"></i>' 
                            : '<i class="far fa-flag text-muted"></i>';

                        const subjectWithPreview = email.subject + 
                            (email.preview ? '<br><small class="text-muted">' + email.preview + '</small>' : '');

                        $tableBody.append('<tr><td>' + email.date + '</td><td>' + email.from + '</td><td>' + subjectWithPreview + '</td>' +
                            '<td class="text-center">' +
                            '<button class="btn btn-sm btn-link p-1 toggleFavorite" data-email-id="' + email.id + '" title="Favorite">' + favoriteIcon + '</button>' +
                            '<button class="btn btn-sm btn-link p-1 toggleFollowUp" data-email-id="' + email.id + '" title="Follow Up">' + followUpIcon + '</button>' +
                            '</td>' +
                            '<td><button class="btn btn-link openEmail" data-email-id="' + email.id + '">Open</button>' +
                            attachmentButton + '</td></tr>');
                    });

                    $currentPage.text(page);
                    $prevPage.prop('disabled', page <= 1);
                    $nextPage.prop('disabled', !data.hasMorePages);

                    $spinner.removeClass('visible');
                    $table.show();
                },
                error: function(xhr, status, error) {
                    console.error('Error loading emails:', error);
                    $spinner.removeClass('visible');
                    $table.show();
                }
            });
        }

        $('.accordion-button').on('click', function () {
            const imapId = $(this).attr('data-bs-target').split('_')[1];
            $('#currentPage_' + imapId).text(1);
            loadEmails(imapId, 1, 10, '', false, '', '', false, false);
        });

        $(document).on('click', '.prevPage', function () {
            const imapId = $(this).data('imap-id');
            const currentPage = parseInt($('#currentPage_' + imapId).text(), 10);
            if (currentPage > 1) {
                loadEmails(imapId, currentPage - 1, 10,
                    $('#searchInput_' + imapId).val(),
                    $('#searchBody_' + imapId).is(':checked'),
                    $('#dateFrom_' + imapId).val(),
                    $('#dateTo_' + imapId).val(),
                    $('[data-imap-id="' + imapId + '"].toggleFilterFavorite').hasClass('active'),
                    $('[data-imap-id="' + imapId + '"].toggleFilterFollowUp').hasClass('active'));
            }
        });

        $(document).on('click', '.nextPage', function () {
            const imapId = $(this).data('imap-id');
            const currentPage = parseInt($('#currentPage_' + imapId).text(), 10);
            loadEmails(imapId, currentPage + 1, 10,
                $('#searchInput_' + imapId).val(),
                $('#searchBody_' + imapId).is(':checked'),
                $('#dateFrom_' + imapId).val(),
                $('#dateTo_' + imapId).val(),
                $('[data-imap-id="' + imapId + '"].toggleFilterFavorite').hasClass('active'),
                $('[data-imap-id="' + imapId + '"].toggleFilterFollowUp').hasClass('active'));
        });

        $(document).on('click', '.searchEmail', function () {
            const imapId = $(this).data('imap-id');
            loadEmails(imapId, 1, 10,
                $('#searchInput_' + imapId).val(),
                $('#searchBody_' + imapId).is(':checked'),
                $('#dateFrom_' + imapId).val(),
                $('#dateTo_' + imapId).val(),
                $('[data-imap-id="' + imapId + '"].toggleFilterFavorite').hasClass('active'),
                $('[data-imap-id="' + imapId + '"].toggleFilterFollowUp').hasClass('active'));
        });

        $(document).on('click', '.clearDates', function () {
            const imapId = $(this).data('imap-id');
            const fpInstance = document.getElementById('dateRange_' + imapId)._flatpickr;
            if (fpInstance) fpInstance.clear();
            $('#dateFrom_' + imapId).val('');
            $('#dateTo_' + imapId).val('');
            loadEmails(imapId, 1, 10,
                $('#searchInput_' + imapId).val(),
                $('#searchBody_' + imapId).is(':checked'),
                '', '',
                $('[data-imap-id="' + imapId + '"].toggleFilterFavorite').hasClass('active'),
                $('[data-imap-id="' + imapId + '"].toggleFilterFollowUp').hasClass('active'));
        });

        $(document).on('click', '.resetSearch', function () {
            const imapId = $(this).data('imap-id');
            $('#searchInput_' + imapId).val('');
            $('#searchBody_' + imapId).prop('checked', false);
            const fpInstance = document.getElementById('dateRange_' + imapId)._flatpickr;
            if (fpInstance) fpInstance.clear();
            $('#dateFrom_' + imapId).val('');
            $('#dateTo_' + imapId).val('');
            $('[data-imap-id="' + imapId + '"].toggleFilterFavorite').removeClass('active btn-warning').addClass('btn-outline-warning').find('i').removeClass('fas').addClass('far');
            $('[data-imap-id="' + imapId + '"].toggleFilterFollowUp').removeClass('active btn-danger').addClass('btn-outline-danger').find('i').removeClass('fas').addClass('far');
            loadEmails(imapId, 1, 10, '', false, '', '', false, false);
        });

        $(document).on('click', '.toggleFilterFavorite', function () {
            const imapId = $(this).data('imap-id');
            const $btn = $(this);
            const isActive = $btn.hasClass('active');
            if (isActive) {
                $btn.removeClass('active btn-warning').addClass('btn-outline-warning').find('i').removeClass('fas').addClass('far');
            } else {
                $btn.addClass('active btn-warning').removeClass('btn-outline-warning').find('i').removeClass('far').addClass('fas');
            }
            loadEmails(imapId, 1, 10,
                $('#searchInput_' + imapId).val(),
                $('#searchBody_' + imapId).is(':checked'),
                $('#dateFrom_' + imapId).val(),
                $('#dateTo_' + imapId).val(),
                !isActive,
                $('[data-imap-id="' + imapId + '"].toggleFilterFollowUp').hasClass('active'));
        });

        $(document).on('click', '.toggleFilterFollowUp', function () {
            const imapId = $(this).data('imap-id');
            const $btn = $(this);
            const isActive = $btn.hasClass('active');
            if (isActive) {
                $btn.removeClass('active btn-danger').addClass('btn-outline-danger').find('i').removeClass('fas').addClass('far');
            } else {
                $btn.addClass('active btn-danger').removeClass('btn-outline-danger').find('i').removeClass('far').addClass('fas');
            }
            loadEmails(imapId, 1, 10,
                $('#searchInput_' + imapId).val(),
                $('#searchBody_' + imapId).is(':checked'),
                $('#dateFrom_' + imapId).val(),
                $('#dateTo_' + imapId).val(),
                $('[data-imap-id="' + imapId + '"].toggleFilterFavorite').hasClass('active'),
                !isActive);
        });

        $(document).on('click', '.toggleFavorite', function () {
            const $button = $(this);
            const emailId = $button.data('email-id');

            $.ajax({
                url: '/Archive/Index?handler=ToggleFavorite',
                type: 'POST',
                headers: {
                    'RequestVerificationToken': '@token'
                },
                data: JSON.stringify({ emailId: emailId }),
                contentType: 'application/json',
                success: function (data) {
                    const $icon = $button.find('i');
                    if (data.isFavorite) {
                        $icon.removeClass('far text-muted').addClass('fas text-warning');
                    } else {
                        $icon.removeClass('fas text-warning').addClass('far text-muted');
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Error toggling favorite:', error);
                }
            });
        });

        $(document).on('click', '.toggleFollowUp', function () {
            const $button = $(this);
            const emailId = $button.data('email-id');

            $.ajax({
                url: '/Archive/Index?handler=ToggleFollowUp',
                type: 'POST',
                headers: {
                    'RequestVerificationToken': '@token'
                },
                data: JSON.stringify({ emailId: emailId }),
                contentType: 'application/json',
                success: function (data) {
                    const $icon = $button.find('i');
                    if (data.isFollowUp) {
                        $icon.removeClass('far text-muted').addClass('fas text-danger');
                    } else {
                        $icon.removeClass('fas text-danger').addClass('far text-muted');
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Error toggling follow-up:', error);
                }
            });
        });
    });
</script>
